node_modules/
dist/
*.tsbuildinfo
.DS_Store

# Local env — never commit secrets
.env
.env.local
.env.*.local

# VHK runtime tripwire — local-only, never commit
.vhk/HARD_STOP

# VHK 개인 메모/참고링크 — 로컬 전용 (docs/spec.md 트래킹 정책)
.vhk/memory.json
# recall 사용 로그·평가셋 (RFC 0049) — 개인 쿼리/기억 참조, 로컬 전용
.vhk/recall-log.jsonl
.vhk/eval/
# 백업·원자적 쓰기 임시 파일 (.bak / .v1.bak / .tmp) 도 로컬 전용 — 절대 커밋 금지
.vhk/memory.json.*
.vhk/refs.json
# secret gist 포인터 (gistId) — 공개 repo 노출 방지 (VHK-022)
.vhk/cloud.json
.vhk/.cloud.json.tmp-*
# 로컬 미션 범위 계약(vhk mission set) — 프로젝트별 로컬 상태, 공유 대상 아님
.vhk/mission.json
# 권한 정책 설정과 그 해시 베이스라인 (RFC 0066 §7.3) — 자율 실행의 상한을 정하는 로컬 전용 파일.
# 베이스라인은 policy.json 변조 탐지용이라 같이 추적하면 둘을 함께 고치는 경로가 커밋에 남는다.
.vhk/policy.json
.vhk/policy-baseline.json
.vhk/.policy-baseline.json.tmp-*
# 자율 런 단위 상태(호출 수·경과) — 런 중에만 존재하는 로컬 계측값 (RFC 0067 §5.3-3)
.vhk/run-state.json
.vhk/run-state.lock
.vhk/run-state-recovery.lock
.vhk/.run-state.json.tmp-*
# SEO 대시보드 로컬 설정(vhk seo init) — 관리 사이트 목록은 프로젝트별 로컬 상태, 공유 대상 아님.
# (값 없이 환경변수 참조만 담지만, 로컬 상태이므로 mission.json 과 동일하게 커밋 제외.)
.vhk/seo/

# EnterWorktree 가 .claude/worktrees/ 에 isolated 복사본 생성 — 커밋 금지
.claude/worktrees/

# 서브에이전트(critic 등) 로컬 학습 메모리 — 머신별 산출물, 커밋 금지
.claude/agent-memory/

# VHK 저장소 관리자 개인 운영 산출물 — 공개 HEAD 추적 금지
.agents/SOUL.md
# 개발자 홈의 범용 규칙 파일(VHK_RULES_FILE · ~/.vhk/config.json 의 rulesFile)에서 재생성된다.
# 추적하면 개인 규칙 원문이 공개되고, 되돌리면 `vhk sync --check` 가 영구 red 가 된다.
# 프로젝트 공통 규칙은 RULES.md 담당 — 이 파일은 개인 상속물이라 추적 대상이 아니다.
.agents/CORE-RULES.md
.vhk/config.json
.vhk/events/*.jsonl
.vhk/ledger.jsonl
docs/log/
docs/state/
docs/devlog/
goals/
# goal 검사 스크립트 — goals/ 카드와 같은 단위(카드가 비추적이면 그 검사도 비추적).
# `check-goal-frontmatter.mjs` 같은 이름 있는 스크립트는 제품 검사라 계속 추적한다.
scripts/check-goal-[0-9]*.mjs
.claude/agents/memtest.md
.claude/skills/auto-merge/
# `.claude/skills/overnight-vhk-auto/` 는 113-T8 로 추적 전환 — 저장소가 SoT 다.
# 개인 절대경로는 VHK_AUTO_PR_SCRIPT 환경변수로 뺐고 boundary:check 가 재유입을 막는다.
docs/runbooks/overnight-vhk-auto.md
docs/runbooks/MORNING_AUTONOMY_MERGE.md
docs/prompts/autonomy/

# Cursor MCP 설정 — 절대 로컬 경로 포함, 머신별 — 커밋 금지 (VHK-022 hygiene)
# ecosystem.mdc 만 예외 (E5-01 vhk-inject-bootstrap 템플릿 dogfood)
.cursor/*
!.cursor/rules/
!.cursor/rules/ecosystem.mdc
!.cursor/mcp.json.example

# Serena MCP 로컬 캐시/프로젝트 메모 — 머신별 툴 산출물, 커밋 금지
.serena/

# coverage 리포트 — 파생 산출물(vitest --coverage), 버려도 됨 (Goal 50 / RFC 0050)
coverage/
.vhk/_*.log
