{
  "name": "@byh3071/vhk",
  "version": "2.15.1",
  "packageManager": "pnpm@11.17.0",
  "description": "VHK — AI 코딩 세션을 목표·증거·기억·규칙으로 묶는 한국어 CLI. 규칙 동기화, MCP 35 tools, verify/review/preflight 게이트.",
  "bin": {
    "vhk": "dist/index.js",
    "vhk-mcp": "dist/mcp/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest --run",
    "skills:generate": "node scripts/gen-agent-skills.mjs",
    "skills:check": "node scripts/gen-agent-skills.mjs --check",
    "skills:pack-check": "node scripts/check-agent-skill-pack.mjs",
    "boundary:check": "node scripts/check-public-boundary.mjs",
    "boundary:history": "node scripts/check-public-boundary.mjs --git-only --all-refs",
    "security:audit": "pnpm audit --audit-level high",
    "prepublishOnly": "pnpm skills:check && pnpm build && pnpm skills:pack-check && pnpm test:run && pnpm boundary:check && pnpm security:audit",
    "save": "vhk save",
    "check": "vhk check",
    "scan": "vhk secure scan",
    "recap": "vhk recap",
    "ship": "vhk ship",
    "doctor": "vhk doctor",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "vibe-coding",
    "harness",
    "cli",
    "mcp",
    "ai-agent",
    "agentic-coding",
    "scaffold",
    "session-log",
    "rules-sync",
    "portability",
    "ai-coding",
    "verification",
    "proof",
    "guardrails",
    "test-first",
    "cursor",
    "claude",
    "claude-code",
    "windsurf",
    "copilot",
    "antigravity",
    "gemini",
    "cline",
    "context-sync"
  ],
  "author": "yohanstudio <opensource@yohanstudio.co>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byh3071-cpu/vhk.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^5.22.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "handlebars": "^4.7.9",
    "inquirer": "^9.3.8",
    "ora": "^9.4.0",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "fast-check": "^4.8.0",
    "ignore": "^7.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.7"
  }
}
